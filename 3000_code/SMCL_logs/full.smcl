. **************************************************
. * DETERMINING BORDER STATE PRICEWISE DOMINANCE 
. **************************************************
. use "pciv\PCIV\Application\EstimationData\temp_all.dta", replace
{txt}
{com}. 
. drop state_abbrev state_name 
{txt}
{com}. statastates, name(state)
{res}{txt}(18,360 real changes made)
{res}
{txt}{col 5}Result{col 33}Number of obs
{col 5}{hline 41}
{col 5}Not matched{col 30}{res}               0
{txt}{col 5}Matched{col 30}{res}          18,360{txt}  (_merge==3)
{col 5}{hline 41}
{res}{txt}
{com}. 
. * this chunk to check the sanity of finalized pricewise population ratio measures 
. *keep state_abbrev state_fips price 
. *bysort state_abbrev: egen avg_price = mean(price) 
. *drop price 
. *duplicates drop 
. *sort state_fips 
. *bro 
. 
. keep state_abbrev year month price
{txt}
{com}. 
. order state_abbrev year month price
{txt}
{com}. sort state_abbrev year month 
{txt}
{com}. 
. save "2000_data\state_year_month_prices", replace
{txt}{p 0 4 2}
file {bf}
2000_data\state_year_month_prices.dta{rm}
saved
{p_end}

{com}. 
. * 1989 to 2018, giving 348 monthly observations for balanced sample 
. 
. joinby state_abbrev using "2000_data\border_states"
{txt}
{com}. 
. rename state_abbrev state_main 
{res}{txt}
{com}. rename price price_main 
{res}{txt}
{com}. 
. order state_main year month price_main 
{txt}
{com}. sort state_main year month price_main 
{txt}
{com}. 
. gen state_abbrev = neighbor_state 
{txt}(360 missing values generated)

{com}. 
. joinby state_abbrev year month using "2000_data\state_year_month_prices"
{txt}
{com}. 
. drop state_abbrev 
{txt}
{com}. rename price neighbor_price 
{res}{txt}
{com}. 
. * identifying (+ counting) year-month obs where neighbor is cheaper
. gen neighbor_cheaper = neighbor_price < price_main 
{txt}
{com}. 
. * counting number of cheaper neighbors for each yearmo 
. bysort state_main year month: egen yearmo_n_cheaper = total(neighbor_cheaper)
{txt}
{com}. 
. * majority rule: neighbor is cheaper in most months 
. bysort state_main neighbor_state: egen months_total = count(neighbor_price) 
{txt}
{com}. bysort state_main neighbor_state: egen months_cheaper = total(neighbor_cheaper)
{txt}
{com}. gen pct_cheaper = months_cheaper / months_total 
{txt}
{com}. gen consistently_cheaper = pct_cheaper >= 0.75 
{txt}
{com}. 
. * identifying if neighbor is cheaper in ALL months 
. gen always_cheaper = (months_cheaper == months_total) 
{txt}
{com}. 
. * calculating average price differences 
. gen price_diff = price_main - neighbor_price 
{txt}
{com}. 
. bysort state_main neighbor_state: egen avg_pdiff = mean(price_diff)
{txt}
{com}. gen avg_neighbor_cheaper = avg_pdiff > 0 
{txt}
{com}. 
. * ranking neighboring-states by median price advantage 
. bysort state_main neighbor_state: egen median_pdiff = median(price_diff)
{txt}
{com}. 
. * collapsing back to state+neighbor combinations 
. collapse (mean) pct_cheaper ///
>         (sum) months_cheaper (count) months_total ///
>         (mean) avg_pdiff ///
>         (median) median_pdiff, ///
>         by(state_main neighbor_state) 
{res}{txt}
{com}. 
. drop months_total months_cheaper 
{txt}
{com}. 
. * labeling variables 
. la var pct_cheaper "State-Neighbor Pairs: Percentage of Months Where Neighbor Is Cheaper"
{txt}
{com}. la var avg_pdiff "State-Neighbor Pairs: Average Price Above Neighbor"
{txt}
{com}. la var median_pdiff "State-Neighbor Pairs: Median Price Above Neighbor"
{txt}
{com}. 
. gen NeighborFreqCheaper = pct_cheaper 
{txt}
{com}. gen NeighborAvgCheaper = avg_pdiff
{txt}
{com}. gen NeighborMedianCheaper = median_pdiff
{txt}
{com}. 
. estpost correlate NeighborFreqCheaper NeighborAvgCheaper NeighborMedianCheaper, matrix label 

{txt}{space 0}{space 0}{ralign 12:}{space 1}{c |}{space 1}{ralign 9:e(b)}{space 1}{space 1}{ralign 9:e(rho)}{space 1}{space 1}{ralign 9:e(p)}{space 1}{space 1}{ralign 9:e(count)}{space 1}
