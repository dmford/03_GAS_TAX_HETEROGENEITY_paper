. **************************************************
. import delimited "2000_data\census_county_adjacency_file_2025.txt", clear 
{res}{txt}(encoding automatically selected: ISO-8859-1)
{text}(5 vars, 18,968 obs)

{com}. 
. gen state_fips = int(countygeoid/1000)
{txt}
{com}. rename countygeoid FIPSCode
{res}{txt}
{com}. drop if state_fips > 56
{txt}(393 observations deleted)

{com}. 
. gen neighbor_state = substr(neighborname, -2, 2)
{txt}(3 missing values generated)

{com}. statastates, fips(state_fips)
{res}{txt}  (all {it:newnames}=={it:oldnames})
{res}
{txt}{col 5}Result{col 33}Number of obs
{col 5}{hline 41}
{col 5}Not matched{col 30}{res}               0
