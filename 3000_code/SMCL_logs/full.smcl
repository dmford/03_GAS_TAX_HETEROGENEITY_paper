{com}. 
. * environmental regressions: 
. local y = 1
{txt}
{com}. foreach outcome of local outcomes {c -(}
{txt}  2{com}.         reg `outcome' land_area, robust
{txt}  3{com}.         eststo y`y'_m1
{txt}  4{com}.         estadd local weighted "No"
{txt}  5{com}.         reg `outcome' land_area [aweight=`aweight'], robust 
{txt}  6{com}.         eststo y`y'_m1_w
{txt}  7{com}.         estadd local weighted "Yes"
{txt}  8{com}.         
.         reg `outcome' weather_index, robust
{txt}  9{com}.         eststo y`y'_m2
{txt} 10{com}.         estadd local weighted "No"
{txt} 11{com}.         reg `outcome' weather_index [aweight=`aweight'], robust 
{txt} 12{com}.         eststo y`y'_m2_w
{txt} 13{com}.         estadd local weighted "Yes"
{txt} 14{com}.         
.         reg `outcome' flatness_index, robust
{txt} 15{com}.         eststo y`y'_m3
{txt} 16{com}.         estadd local weighted "No"
{txt} 17{com}.         reg `outcome' flatness_index [aweight=`aweight'], robust 
{txt} 18{com}.         eststo y`y'_m3_w
{txt} 19{com}.         estadd local weighted "Yes"
{txt} 20{com}.         
.         esttab y`y'_m1 y`y'_m2 y`y'_m3 using "6000_LaTeX\etable_y`y'_environmental.tex", replace ///
>                 drop(_cons) star(* 0.1 ** 0.05 *** 0.01) b(%4.3f) se(%4.3f) nolegend nonotes ///
>                 coef(land_area "Land Area" weather_index "Weather Ind." flatness_index "Flatness Ind.") ///
>                 mlabels(none) mgroups("Gas Price Elasticity", span prefix(\multicolumn{c -(}@span{c )-}{c -(}c{c )-}{c -(}) suffix({c )-})) stats(weighted N, label("Weights" "Locales:"))
{txt} 21{com}. 
.         esttab y`y'_m1_w y`y'_m2_w y`y'_m3_w using "6000_LaTeX\etable_y`y'_environmental_w.tex", replace ///
>                 drop(_cons) star(* 0.1 ** 0.05 *** 0.01) b(%4.3f) se(%4.3f) nolegend nonotes ///
>                 coef(land_area "Land Area" weather_index "Weather Ind." flatness_index "Flatness Ind.") ///
>                 mlabels(none) mgroups("Gas Price Elasticity", span prefix(\multicolumn{c -(}@span{c )-}{c -(}c{c )-}{c -(}) suffix({c )-})) stats(weighted N, label("Weights" "Locales:"))
{txt} 22{com}.         
.         if `y'==1 {c -(}
{txt} 23{com}.                 esttab y`y'_m1_w y`y'_m2_w y`y'_m3_w using "6000_LaTeX\etable_y`y'_environmental_w_boot.tex", replace ///
>                         drop(_cons) star(* 0.1 ** 0.05 *** 0.01) b(%4.3f) se(%4.3f) nolegend nonotes ///
>                         coef(land_area "Land Area" weather_index "Weather Ind." flatness_index "Flatness Ind.") ///
>                         mlabels(none) mgroups("Gas Price Elasticity", span prefix(\multicolumn{c -(}@span{c )-}{c -(}c{c )-}{c -(}) suffix({c )-})) stats(weighted N, label("Weights" "Locales:"))
{txt} 24{com}.         {c )-}
{txt} 25{com}.         
.         local ++y
{txt} 26{com}. {c )-}

