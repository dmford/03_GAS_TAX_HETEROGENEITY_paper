{hline 13}{c +}{hline 57}
temp_avg_c~r {c |}{res}        224           0    5.167142   -18.8404    18.8404
{txt}
{com}. gen avg_cheaper = temp_avg_cheaper < (r(mean) + `num_sds'*r(sd))
{txt}
{com}. 
. bysort state_abbrev neighbor_state: egen temp_median_cheaper = mean(median_pdiff)
{txt}
{com}. sum temp_median_cheaper 

{txt}    Variable {c |}        Obs        Mean    Std. dev.       Min        Max
{hline 13}{c +}{hline 57}
temp_media~r {c |}{res}        224           0    3.685031      -11.4       11.4
{txt}
{com}. gen median_cheaper = temp_median_cheaper < (r(mean) + `num_sds'*r(sd))
{txt}
{com}. 
. drop temp*
{txt}
{com}. 
. save "2000_data\state_price_dominance", replace
{txt}{p 0 4 2}
file {bf}
2000_data\state_price_dominance.dta{rm}
saved
