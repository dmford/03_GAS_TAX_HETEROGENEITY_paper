{com}. 
. * transportation regressions: 
. local y = 1
{txt}
{com}. foreach outcome of local outcomes {c -(}
{txt}  2{com}.         reg `outcome' urban_mileage, robust
{txt}  3{com}.         eststo y`y'_m1
{txt}  4{com}.         estadd local weighted "No"
{txt}  5{com}.         reg `outcome' urban_mileage [aweight=`aweight'], robust 
{txt}  6{com}.         eststo y`y'_m1_w
{txt}  7{com}.         estadd local weighted "Yes"
{txt}  8{com}.         
.         reg `outcome' total_mileage, robust
{txt}  9{com}.         eststo y`y'_m2
{txt} 10{com}.         estadd local weighted "No"
{txt} 11{com}.         reg `outcome' total_mileage [aweight=`aweight'], robust 
{txt} 12{com}.         eststo y`y'_m2_w
{txt} 13{com}.         estadd local weighted "Yes"
{txt} 14{com}.         
.         reg `outcome' urban_roadshare, robust
{txt} 15{com}.         eststo y`y'_m4
{txt} 16{com}.         estadd local weighted "No"
{txt} 17{com}.         reg `outcome' urban_roadshare [aweight=`aweight'], robust 
{txt} 18{com}.         eststo y`y'_m4_w
{txt} 19{com}.         estadd local weighted "Yes"
{txt} 20{com}.         
.         reg `outcome' pub_tran_average, robust
{txt} 21{com}.         eststo y`y'_m5
{txt} 22{com}.         estadd local weighted "No"
{txt} 23{com}.         reg `outcome' pub_tran_average [aweight=`aweight'], robust 
{txt} 24{com}.         eststo y`y'_m5_w
{txt} 25{com}.         estadd local weighted "Yes"
{txt} 26{com}.         
.         esttab y`y'_m1 y`y'_m2 y`y'_m4 y`y'_m5 using "6000_LaTeX\etable_y`y'_transportation.tex", replace ///
>                 drop(_cons) star(* 0.1 ** 0.05 *** 0.01) b(%4.3f) se(%4.3f) nolegend nonotes ///
>                 coef(urban_mileage "Urban Roads" total_mileage "All Roads" urban_roadshare "Urbanization" pub_tran_average "Pub. Trans.") ///
>                 mlabels(none) mgroups("Gas Price Elasticity", span prefix(\multicolumn{c -(}@span{c )-}{c -(}c{c )-}{c -(}) suffix({c )-})) stats(weighted N, label("Weights" "Locales:"))
{txt} 27{com}. 
.         esttab y`y'_m1_w y`y'_m2_w y`y'_m4_w y`y'_m5_w using "6000_LaTeX\etable_y`y'_transportation_w.tex", replace ///
>                 drop(_cons) star(* 0.1 ** 0.05 *** 0.01) b(%4.3f) se(%4.3f) nolegend nonotes ///
>                 coef(urban_mileage "Urban Roads" total_mileage "All Roads" urban_roadshare "Urbanization" pub_tran_average "Pub. Trans.") ///
>                 mlabels(none) mgroups("Gas Price Elasticity", span prefix(\multicolumn{c -(}@span{c )-}{c -(}c{c )-}{c -(}) suffix({c )-})) stats(weighted N, label("Weights" "Locales:"))
{txt} 28{com}.         
.         if `y'==1 {c -(}
{txt} 29{com}.                 esttab y`y'_m1_w y`y'_m2_w y`y'_m4_w y`y'_m5_w using "6000_LaTeX\etable_y`y'_transportation_w_boot.tex", replace ///
>                         drop(_cons) star(* 0.1 ** 0.05 *** 0.01) b(%4.3f) se(%4.3f) nolegend nonotes ///
>                         coef(urban_mileage "Urban Roads" total_mileage "All Roads" urban_roadshare "Urbanization" pub_tran_average "Pub. Trans.") ///
>                         mlabels(none) mgroups("Gas Price Elasticity", span prefix(\multicolumn{c -(}@span{c )-}{c -(}c{c )-}{c -(}) suffix({c )-})) stats(weighted N, label("Weights" "Locales:"))
{txt} 30{com}.         {c )-}
{txt} 31{com}.         
.         local ++y
{txt} 32{com}. {c )-}

