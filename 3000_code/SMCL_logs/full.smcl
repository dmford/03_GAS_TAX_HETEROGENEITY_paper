{com}. 
. * demographic regressions: 
. local y = 1
{txt}
{com}. foreach outcome of local outcomes {c -(}
{txt}  2{com}.         reg `outcome' state_pop, robust
{txt}  3{com}.         eststo y`y'_m1
{txt}  4{com}.         estadd local weighted "No"
{txt}  5{com}.         reg `outcome' state_pop [aweight=`aweight'], robust 
{txt}  6{com}.         eststo y`y'_m1_w
{txt}  7{com}.         estadd local weighted "Yes"
{txt}  8{com}.         
.         reg `outcome' pop_density, robust
{txt}  9{com}.         eststo y`y'_m2
{txt} 10{com}.         estadd local weighted "No"
{txt} 11{com}.         reg `outcome' pop_density [aweight=`aweight'], robust 
{txt} 12{com}.         eststo y`y'_m2_w
{txt} 13{com}.         estadd local weighted "Yes"
{txt} 14{com}.         
.         reg `outcome' border_pop_share, robust
{txt} 15{com}.         eststo y`y'_m3
{txt} 16{com}.         estadd local weighted "No"
{txt} 17{com}.         reg `outcome' border_pop_share [aweight=`aweight'], robust 
{txt} 18{com}.         eststo y`y'_m3_w
{txt} 19{com}.         estadd local weighted "Yes"
{txt} 20{com}.         
.         reg `outcome' licensure, robust
{txt} 21{com}.         eststo y`y'_m4
{txt} 22{com}.         estadd local weighted "No"
{txt} 23{com}.         reg `outcome' licensure [aweight=`aweight'], robust 
{txt} 24{com}.         eststo y`y'_m4_w
{txt} 25{com}.         estadd local weighted "Yes"
{txt} 26{com}.         
.         esttab y`y'_m1 y`y'_m2 y`y'_m3 y`y'_m4 using "6000_LaTeX\etable_y`y'_demographic.tex", replace ///
>                 drop(_cons) star(* 0.1 ** 0.05 *** 0.01) b(%4.3f) se(%4.3f) nolegend nonotes ///
>                 coef(state_pop "Population" pop_density "Pop. Density" border_pop_share "Border Pop." licensure "Licensure") ///
>                 mlabels(none) mgroups("Gas Price Elasticity", span prefix(\multicolumn{c -(}@span{c )-}{c -(}c{c )-}{c -(}) suffix({c )-})) stats(weighted N, label("Weights" "Locales:"))
{txt} 27{com}. 
.         esttab y`y'_m1_w y`y'_m2_w y`y'_m3_w y`y'_m4_w using "6000_LaTeX\etable_y`y'_demographic_w.tex", replace ///
>                 drop(_cons) star(* 0.1 ** 0.05 *** 0.01) b(%4.3f) se(%4.3f) nolegend nonotes ///
>                 coef(state_pop "Population" pop_density "Pop. Density" border_pop_share "Border Pop." licensure "Licensure") ///
>                 mlabels(none) mgroups("Gas Price Elasticity", span prefix(\multicolumn{c -(}@span{c )-}{c -(}c{c )-}{c -(}) suffix({c )-})) stats(weighted N, label("Weights" "Locales:"))
{txt} 28{com}.         
.         if `y'==1 {c -(}
{txt} 29{com}.                 esttab y`y'_m1_w y`y'_m2_w y`y'_m3_w y`y'_m4_w using "6000_LaTeX\etable_y`y'_demographic_w_boot.tex", replace ///
>                         drop(_cons) star(* 0.1 ** 0.05 *** 0.01) b(%4.3f) se(%4.3f) nolegend nonotes ///
>                         coef(state_pop "Population" pop_density "Pop. Density" border_pop_share "Border Pop." licensure "Licensure") ///
>                         mlabels(none) mgroups("Gas Price Elasticity", span prefix(\multicolumn{c -(}@span{c )-}{c -(}c{c )-}{c -(}) suffix({c )-})) stats(weighted N, label("Weights" "Locales:"))
{txt} 30{com}.         {c )-}
{txt} 31{com}. 
.         local ++y
{txt} 32{com}.         drop _est*
{txt} 33{com}. {c )-}

