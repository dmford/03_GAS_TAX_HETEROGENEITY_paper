{com}. 
. replace land_area = (land_area / 1000000)
{txt}variable {bf}{res}land_area{sf}{txt} was {bf}{res}long{sf}{txt} now {bf}{res}double{sf}
{txt}(51 real changes made)

{com}. replace urban_mileage = (urban_mileage / 100000)
{txt}variable {bf}{res}urban_mileage{sf}{txt} was {bf}{res}long{sf}{txt} now {bf}{res}double{sf}
{txt}(51 real changes made)

{com}. replace total_mileage = (total_mileage / 100000)
{txt}variable {bf}{res}total_mileage{sf}{txt} was {bf}{res}long{sf}{txt} now {bf}{res}double{sf}
{txt}(51 real changes made)

{com}. replace state_pop = state_pop/1000000
{txt}(51 real changes made)

{com}. replace licensure = (licensure / 1000)
{txt}variable {bf}{res}licensure{sf}{txt} was {bf}{res}int{sf}{txt} now {bf}{res}float{sf}
{txt}(51 real changes made)

{com}. replace licensed_drivers = licensed_drivers/1000000
{txt}variable {bf}{res}licensed_drivers{sf}{txt} was {bf}{res}long{sf}{txt} now {bf}{res}double{sf}
{txt}(51 real changes made)

{com}. 
. order state_fips state_abbrev state_name elasticity b1_logprice b2_logprice pub_tran_average rain_inches min_temp avg_temp max_temp flattest flatter flat not_flat total_area land_area water_area border_county_length border_pop state_pop border_pop_share
{txt}
{com}. sort state_fips
{txt}
{com}. 
. drop rural_mileage rural_roadshare 
{txt}
{com}. drop licensed_rate 
{txt}
{com}. drop total_area water_area
{txt}
{com}. drop border_county_length
{txt}
{com}. 
. **************************************************
. * LABELING VARIABLES + CORRELATION MATRICES
. **************************************************
. * outcomes
. local outcomes = "b1_logprice b2_logprice elasticity"
{txt}
{com}. la var b1_logprice "Elasticity, Without Controls"
{txt}
{com}. la var b2_logprice "Elasticity, With Controls"
{txt}
{com}. la var elasticity "Elasticity"
{txt}
{com}. 
. * environmental predictors 
. local environmental_predictors = "land_area" 
{txt}
{com}. la var land_area "Land Area (M Sq. Miles)"
{txt}
{com}. la var min_temp "Min. Temp. (F)"
{txt}
{com}. la var avg_temp "Avg. Temp. (F)"
{txt}
{com}. la var max_temp "Max. Temp. (F)"
{txt}
{com}. la var rain_inches "Annual Rain (Inches)"
{txt}
{com}. la var weather_index "Weather Quality Index"
{txt}
{com}. la var flat "Flat Area"
{txt}
{com}. la var flatter "Flatter Area"
{txt}
{com}. la var flattest "Flattest Area"
{txt}
{com}. la var any_flat "Non-Steep"
{txt}
{com}. la var flatness_index "Flatness Ind."
{txt}
{com}. 
. * transportation predictors 
. local transportation_predictors = "urban_mileage total_mileage urban_roadshare pub_tran_average"
{txt}
{com}. la var urban_mileage "Urban Road-Miles"
{txt}
{com}. la var total_mileage "Total Road-Miles"
{txt}
{com}. la var urban_roadshare "Road Urbanization"
{txt}
{com}. la var pub_tran_average "Pub. Trans. Usage"
{txt}
{com}. 
. * demographic predictors
. local demographic_predictors = "state_pop pop_density licensure border_pop_share"
{txt}
{com}. local cheaper_neighbor "freq_border_pop_share avg_border_pop_share med_border_pop_share"
{txt}
{com}. la var state_pop "State Pop. (M)"
{txt}
{com}. la var pop_density "Pop. Per 100 Sq. Miles"
{txt}
{com}. la var border_pop_share "Border Pop. Share"
{txt}
{com}. la var freq_border_pop_share "Border Pop. Share, Often Cheaper"
{txt}
{com}. la var avg_border_pop_share "Border Pop. Share, Avg. Cheaper"
{txt}
{com}. la var med_border_pop_share "Border Pop. Share, Med. Cheaper"
{txt}
{com}. la var licensure "Licensure Rate"
{txt}
{com}. 
. * analytical weight
. local aweight = "licensed_drivers"
{txt}
{com}. la var licensed_drivers "Licensed Drivers (M)"
{txt}
{com}. 
. local x_list = "`environmental_predictors' `transportation_predictors' `demographic_predictors' `aweight'"
{txt}
{com}. 
. save "2000_data\gas_elasticity_dataset", replace
{txt}{p 0 4 2}
file {bf}
2000_data\gas_elasticity_dataset.dta{rm}
saved
{p_end}

{com}. 
. **************************************************
. * BOOTSTRAPPED STANDARD ERRORS
. **************************************************
. * I ran bootstrap regressions with 500 iterations to obtain corrected standard errors. 
. * I then use "boot_append.do" to append them all together (I split it up to expedite the very slow process)
. * this section should pull the sd of those and save them as local macros to be used as se's in the third of each table below 
. * I have further made copies of the tables with weighted estimates here, but they will need to have the SEs and stars entered MANUALLY. 
. 
. **************************************************
. * DSTATS + REGRESSIONS + ESTIMATES TABLES
. **************************************************
. use "2000_data\gas_elasticity_dataset", replace
{txt}
{com}. 
. * main regressions: 
. local y = 1
{txt}
{com}. foreach outcome of local outcomes {c -(}
{txt}  2{com}.         collect clear 
{txt}  3{com}.         dtable b1_logprice b2_logprice land_area min_temp avg_temp max_temp rain_inches `transportation_predictors' `demographic_predictors' `cheaper_neighbor' `aweight', ///
>                 name(dstats_`outcome') nosample title("Raw Differences") 
{txt}  4{com}.         collect export "6000_LaTeX\dstats_y`y'.tex", replace tableonly 
{txt}  5{com}.         
.         collect clear 
{txt}  6{com}.         dtable b1_logprice land_area total_mileage urban_roadshare state_pop pop_density border_pop_share freq_border_pop_share licensed_drivers, name(dstats_y1_short) nosample title("Raw Differences")
{txt}  7{com}.         collect export "6000_LaTeX\dstats_y1_short.tex", replace tableonly 
{txt}  8{com}.         
.         reg `outcome' land_area, robust
{txt}  9{com}.         eststo y`y'_m1
{txt} 10{com}.         estadd local weighted "No"
{txt} 11{com}.         reg `outcome' land_area [aweight=`aweight'], robust 
{txt} 12{com}.         eststo y`y'_m1_w
{txt} 13{com}.         estadd local weighted "Yes"
{txt} 14{com}. 
.         reg `outcome' weather_index, robust
{txt} 15{com}.         eststo y`y'_m2
{txt} 16{com}.         estadd local weighted "No"
{txt} 17{com}.         reg `outcome' weather_index [aweight=`aweight'], robust 
{txt} 18{com}.         eststo y`y'_m2_w
{txt} 19{com}.         estadd local weighted "Yes"
{txt} 20{com}.         
.         reg `outcome' urban_roadshare, robust
{txt} 21{com}.         eststo y`y'_m3
{txt} 22{com}.         estadd local weighted "No"
{txt} 23{com}.         reg `outcome' urban_roadshare [aweight=`aweight'], robust 
{txt} 24{com}.         eststo y`y'_m3_w
{txt} 25{com}.         estadd local weighted "Yes"
{txt} 26{com}.         
.         reg `outcome' pop_density, robust
{txt} 27{com}.         eststo y`y'_m4
{txt} 28{com}.         estadd local weighted "No"
{txt} 29{com}.         reg `outcome' pop_density [aweight=`aweight'], robust 
{txt} 30{com}.         eststo y`y'_m4_w
{txt} 31{com}.         estadd local weighted "Yes"
{txt} 32{com}.         
.         reg `outcome' freq_border_pop_share, robust
{txt} 33{com}.         eststo y`y'_m5
{txt} 34{com}.         estadd local weighted "No"
{txt} 35{com}.         reg `outcome' freq_border_pop_share [aweight=`aweight'], robust 
{txt} 36{com}.         eststo y`y'_m5_w
{txt} 37{com}.         estadd local weighted "Yes"
{txt} 38{com}.         
.         reg `outcome' land_area weather_index urban_roadshare pop_density freq_border_pop_share, robust
{txt} 39{com}.         eststo y`y'_m6
{txt} 40{com}.         estadd local weighted "No"
{txt} 41{com}.         reg `outcome' land_area weather_index urban_roadshare pop_density freq_border_pop_share [aweight=`aweight'], robust 
{txt} 42{com}.         eststo y`y'_m6_w
{txt} 43{com}.         estadd local weighted "Yes"
{txt} 44{com}.         
.         esttab y`y'_m1 y`y'_m2 y`y'_m3 y`y'_m4 y`y'_m5 y`y'_m6 using "6000_LaTeX\etable_y`y'_main.tex", replace ///
>                 drop(_cons) star(* 0.1 ** 0.05 *** 0.01) b(%4.3f) se(%4.3f) nolegend nonotes ///
>                 coef(land_area "Land Area" weather_index "Weather Ind." urban_roadshare "Urbanization" pop_density "Pop. Density" freq_border_pop_share "Cheaper Border") ///
>                 mlabels(none) mgroups("Gas Price Elasticity", span prefix(\multicolumn{c -(}@span{c )-}{c -(}c{c )-}{c -(}) suffix({c )-})) stats(weighted N, label("Weights" "Locales:"))
{txt} 45{com}. 
.         esttab y`y'_m1_w y`y'_m2_w y`y'_m3_w y`y'_m4_w y`y'_m5_w y`y'_m6_w using "6000_LaTeX\etable_y`y'_main_w.tex", replace ///
>                 drop(_cons) star(* 0.1 ** 0.05 *** 0.01) b(%4.3f) se(%4.3f) nolegend nonotes ///
>                 coef(land_area "Land Area" weather_index "Weather Ind." urban_roadshare "Urbanization" pop_density "Pop. Density" freq_border_pop_share "Cheaper Border") ///
>                 mlabels(none) mgroups("Gas Price Elasticity", span prefix(\multicolumn{c -(}@span{c )-}{c -(}c{c )-}{c -(}) suffix({c )-})) stats(weighted N, label("Weights" "Locales:"))
{txt} 46{com}.         
.         if `y'==1 {c -(}
{txt} 47{com}.                 esttab y`y'_m1_w y`y'_m2_w y`y'_m3_w y`y'_m4_w y`y'_m5_w y`y'_m6_w using "6000_LaTeX\etable_y`y'_main_w_boot.tex", replace ///
>                         drop(_cons) star(* 0.1 ** 0.05 *** 0.01) b(%4.3f) se(%4.3f) nolegend nonotes ///
>                         coef(land_area "Land Area" weather_index "Weather Ind." urban_roadshare "Urbanization" pop_density "Pop. Density" freq_border_pop_share "Cheaper Border") ///
>                         mlabels(none) mgroups("Gas Price Elasticity", span prefix(\multicolumn{c -(}@span{c )-}{c -(}c{c )-}{c -(}) suffix({c )-})) stats(weighted N, label("Weights" "Locales:"))
{txt} 48{com}.         {c )-}
{txt} 49{com}.         
.         local ++y
{txt} 50{com}. {c )-}
{res}
