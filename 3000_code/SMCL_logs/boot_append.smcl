{txt}
{com}. 
. local tgroups t1 t2 t3 t4 t5 
{txt}
{com}. 
. local whichtable 1
{txt}
{com}. foreach t of local tgroups {c -(}
{txt}  2{com}.         display "Appending Table `t'..."
{txt}  3{com}.         
.         local filelist : dir "." files "*_`t'*.dta" 
{txt}  4{com}.         
.         local n : word count `filelist' 
{txt}  5{com}.         display "Found `n' files for tgroup `t'" 
{txt}  6{com}.         
.         if `n' != 11 {c -(}
{txt}  7{com}.                 display as error "Warning: expected 11 files but found `n' for tgroup `t'"
{txt}  8{com}.         {c )-}
{txt}  9{com}.         
.         local first : word 1 of `filelist' 
{txt} 10{com}.         use "`first'", clear
{txt} 11{com}.         
.         forvalues i = 2/`n' {c -(}
{txt} 12{com}.                 local f : word `i' of `filelist' 
{txt} 13{com}.                 display "Appending `f'" 
{txt} 14{com}.                 append using "`f'" 
{txt} 15{com}.         {c )-}
{txt} 16{com}.         
.         qui count 
{txt} 17{com}.         display as result "combined_`t'.dta has " r(N) " bootstrapped estimates"
{txt} 18{com}. 
.         ds 
{txt} 19{com}.         foreach var of varlist `r(varlist)' {c -(}
{txt} 20{com}.                 rename `var' `var'_`t'
{txt} 21{com}.         {c )-}
{txt} 22{com}. 
.         gen table = `whichtable'
{txt} 23{com}.         gen merge_id = _n
{txt} 24{com}.         order merge_id table
{txt} 25{com}.         drop if merge_id > 500
{txt} 26{com}.         
.         qui count 
{txt} 27{com}.         display as result "combined_`t'.dta has " r(N) " bootstrapped estimates after dropping"
{txt} 28{com}. 
.         save "combined\combined_`t'.dta", replace 
{txt} 29{com}.         display "Saved combined_`t'.dta"
{txt} 30{com}.         
.         local ++whichtable
{txt} 31{com}. {c )-}
