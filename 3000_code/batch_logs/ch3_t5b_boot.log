. replace x_hat_dem`i'_`m' = x_hat_dem`i'_`m'_`var'_`k' if statefip==`k'
 50. 
. }
 51. 
. 
. 
. drop x_hat_dem`i'_`m'_*
 52. 
. 
. 
. 
