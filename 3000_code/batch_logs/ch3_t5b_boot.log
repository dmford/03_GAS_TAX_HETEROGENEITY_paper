100. 
. local j=1
101. 
. foreach var of varlist `pc_ivlist' {
102. 
. local d`j'=sum_comp[`j',1]
103. 
. replace first_`m'_sum_errors`i'_`var'=`d`j'' if statefip==`k'
104. 
. local j `++j'
105. 
. }
106. 
. }
107. 
. foreach var of varlist `pc_ivlist' {
108. 
. egen first_`m'_var`i'_dhat_`var'=sd(first_`m'_dhat`i'_`var') if pickone`i'_1=
> =1
109. 
. egen first_`m'_var`i'_`var'=sd(first_`m'_sum_errors`i'_`var') if pickone`i'_1
> ==1
110. 
. gen first_`m'_se`i'_`var'=sqrt((first_`m'_var`i'_dhat_`var'^2+first_`m'_var`i
> '_`var'^2)/51)
111. 
. gen first_`m'_t`i'_`var'=first_`m'_reg`i'_`var'/first_`m'_se`i'_`var'
112. 
. }
113. 
