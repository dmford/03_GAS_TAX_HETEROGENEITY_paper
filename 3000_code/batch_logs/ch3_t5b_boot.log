. replace `exog'_x_hat_dem`i' = `exog'_x_hat_dem`i'_`k' if statefip==`k'
 38. 
. }
 39. 
. 
. 
. drop `exog'_x_hat_dem`i'_*
 40. 
. }
 41. 
. 
. 
. local m=1
 42. 
. foreach endo of varlist `pc_endoglist' {
 43. 
. gen x_hat_dem`i'_`m'=. 
